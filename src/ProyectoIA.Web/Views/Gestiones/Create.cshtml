@model GestionCreateViewModel

@{
    ViewData["Title"] = "Crear gestión";
}

<h1 class="mb-4">Crear gestión</h1>

<form id="form-crear-gestion" asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="CecoId" class="form-label"></label>
            <select id="ceco" asp-for="CecoId" asp-items="ViewBag.Cecos" class="form-select">
                <option value="">Seleccione...</option>
            </select>
            <span asp-validation-for="CecoId" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="DependenciaId" class="form-label"></label>
            <select id="dependencia" asp-for="DependenciaId" asp-items="ViewBag.Dependencias" class="form-select">
                <option value="">Seleccione...</option>
            </select>
            <span asp-validation-for="DependenciaId" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="TipoSolicitudId" class="form-label"></label>
            <select id="tipo-solicitud" asp-for="TipoSolicitudId" asp-items="ViewBag.TiposSolicitud" class="form-select">
                <option value="">Seleccione...</option>
            </select>
            <span asp-validation-for="TipoSolicitudId" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Objetivo" class="form-label"></label>
        <input id="objetivo" asp-for="Objetivo" class="form-control" />
        <span asp-validation-for="Objetivo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Detalle" class="form-label"></label>
        <textarea id="detalle" asp-for="Detalle" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Detalle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ReferenciaIngreso" class="form-label"></label>
        <input id="referencia" asp-for="ReferenciaIngreso" class="form-control" />
        <span asp-validation-for="ReferenciaIngreso" class="text-danger"></span>
    </div>

    <button id="btn-guardar" type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
