@model GestionCreateViewModel

@{
    ViewData["Title"] = "Crear gestión";
}

<h1 class="mb-4">Crear gestión</h1>

<form id="form-crear-gestion" asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="card mb-3">
        <div class="card-header">Clasificación</div>
        <div class="card-body">
            <fieldset>
                <legend class="visually-hidden">Clasificación de la gestión</legend>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="CecoId" class="form-label"></label>
                        <select id="ceco" asp-for="CecoId" asp-items="ViewBag.Cecos" class="form-select">
                            <option value="">Seleccione...</option>
                        </select>
                        <span asp-validation-for="CecoId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="DependenciaId" class="form-label"></label>
                        <select id="dependencia" asp-for="DependenciaId" class="form-select">
                            <option value="">Seleccione...</option>
                            @foreach (var dependencia in (IEnumerable<Dependencia>)ViewBag.Dependencias)
                            {
                                <option value="@dependencia.Id" data-ceco-id="@dependencia.CecoId">@dependencia.Nombre</option>
                            }
                        </select>
                        <span asp-validation-for="DependenciaId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="TipoSolicitudId" class="form-label"></label>
                        <select id="tipo-solicitud" asp-for="TipoSolicitudId" asp-items="ViewBag.TiposSolicitud" class="form-select">
                            <option value="">Seleccione...</option>
                        </select>
                        <span asp-validation-for="TipoSolicitudId" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Detalle de la solicitud</div>
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Objetivo" class="form-label"></label>
                <input id="objetivo" asp-for="Objetivo" class="form-control" />
                <span asp-validation-for="Objetivo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Detalle" class="form-label"></label>
                <textarea id="detalle" asp-for="Detalle" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Detalle" class="text-danger"></span>
            </div>

            <div class="mb-0">
                <label asp-for="ReferenciaIngreso" class="form-label"></label>
                <input id="referencia" asp-for="ReferenciaIngreso" class="form-control" />
                <span asp-validation-for="ReferenciaIngreso" class="text-danger"></span>
            </div>
        </div>
    </div>

    <button id="btn-guardar" type="submit" class="btn btn-primary">
        <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Guardar
    </button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const ceco = document.getElementById('ceco');
        const dependencia = document.getElementById('dependencia');
        const actualizarDependencias = () => {
            for (const option of dependencia.options) {
                if (!option.value) continue;
                option.disabled = option.dataset.cecoId !== ceco.value;
                if (option.disabled && option.selected) dependencia.value = '';
            }
        };
        ceco.addEventListener('change', actualizarDependencias);
        actualizarDependencias();
    </script>
}
