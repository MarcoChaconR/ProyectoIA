@model DependenciaFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Nueva dependencia" : "Editar dependencia";
}

<h1 class="mb-4">@ViewData["Title"]</h1>
<div class="card">
    <div class="card-body">
        <form id="form-dependencia" asp-action="GuardarDependencia" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="mb-3">
                <label asp-for="CecoId" class="form-label"></label>
                <select id="ceco-dependencia" asp-for="CecoId" asp-items="ViewBag.Cecos" class="form-select">
                    <option value="">Seleccione...</option>
                </select>
                <span asp-validation-for="CecoId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input id="nombre-dependencia" asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <button id="btn-guardar-dependencia" type="submit" class="btn btn-primary">Guardar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>
