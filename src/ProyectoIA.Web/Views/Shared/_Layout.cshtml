@{
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    bool EsActivo(string controller, string? action = null) =>
        string.Equals(controlador, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(accion, action, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoIA.Web</title>
    <meta name="description" content="Sistema interno para centralizar y dar seguimiento a solicitudes de RPA, BPM y Power Platform." />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoIA.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable" href="#contenido">Saltar al contenido principal</a>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom mb-3" aria-label="Navegación principal">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-diagram-3-fill" aria-hidden="true"></i>
                    <span>Gestión de Solicitudes</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Abrir menú de navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark @(EsActivo("Gestiones", "Index") ? "active" : "")" aria-current="@(EsActivo("Gestiones", "Index") ? "page" : null)" asp-controller="Gestiones" asp-action="Index">
                                    <i class="bi bi-list-task me-1" aria-hidden="true"></i>Gestiones
                                </a>
                            </li>
                            @if (User.IsInRole("Cliente"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark @(EsActivo("Gestiones", "Create") ? "active" : "")" aria-current="@(EsActivo("Gestiones", "Create") ? "page" : null)" asp-controller="Gestiones" asp-action="Create">
                                        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Crear gestión
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Administrador") || User.IsInRole("Tecnico"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark @(EsActivo("Dashboard") ? "active" : "")" aria-current="@(EsActivo("Dashboard") ? "page" : null)" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1" aria-hidden="true"></i>Dashboard
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark @(EsActivo("Catalogos") ? "active" : "")" aria-current="@(EsActivo("Catalogos") ? "page" : null)" asp-controller="Catalogos" asp-action="Index">
                                        <i class="bi bi-folder2-open me-1" aria-hidden="true"></i>Catálogos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark @(EsActivo("Usuarios") ? "active" : "")" aria-current="@(EsActivo("Usuarios") ? "page" : null)" asp-controller="Usuarios" asp-action="Index">
                                        <i class="bi bi-people me-1" aria-hidden="true"></i>Usuarios
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-sm-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark">
                                    <i class="bi bi-person-circle me-1" aria-hidden="true"></i>@User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button id="btn-logout" type="submit" class="btn btn-link nav-link text-dark">
                                        <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Iniciar sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main id="contenido" role="main" class="py-3 py-lg-4">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer border-top text-muted py-3 mt-4">
        <div class="container d-flex flex-wrap justify-content-between gap-2 small">
            <span>&copy; 2026 ProyectoIA.Web</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Política de privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
