@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="estado-vacio">
    <i class="bi bi-exclamation-triangle text-danger" aria-hidden="true"></i>
    <h1 class="h4 text-danger">Ocurrió un error al procesar la solicitud</h1>

    @if (Model.ShowRequestId)
    {
        <p class="mb-0">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>

<div class="card mt-4">
    <div class="card-body">
        <h2 class="h5">Modo de desarrollo</h2>
        <p class="mb-2">
            Cambiar al entorno <strong>Development</strong> mostrará información más detallada sobre el error ocurrido.
        </p>
        <p class="mb-0 small text-muted">
            <strong>El entorno Development no debe habilitarse en aplicaciones desplegadas.</strong>
            Puede exponer información sensible de las excepciones a los usuarios finales.
            Para depuración local, habilite el entorno <strong>Development</strong> configurando la variable de entorno
            <strong>ASPNETCORE_ENVIRONMENT</strong> y reiniciando la aplicación.
        </p>
    </div>
</div>
